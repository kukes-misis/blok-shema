# Telegram Bot Configuration Template
# Скопируйте этот файл в .env и укажите ваш токен от @BotFather:
# cp .env.example .env

# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Порт локального веб-сервера
PORT=8080

# URL вашего развернутого веб-приложения для кнопки Mini App внутри Telegram
# (например: https://kukes-misis.github.io/blok-shema/ или https://ваш-домен.ru)
TMA_APP_URL=https://kukes-misis.github.io/blok-shema/

# Настройки защиты от спам-ботов
MAX_CODE_LENGTH=25000
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_COOLDOWN_MS=30000
