#!/usr/bin/env bash
# start.command - Двойной клик для запуска C# ГОСТ Блок-Схема
cd "$(dirname "$0")"

echo "======================================================"
echo "  Запуск Генератора блок-схем C# по ГОСТ 19.701-90"
echo "======================================================"
echo "Запуск сервера: http://localhost:8080 ..."

# Запуск локального сервера в фоновом режиме
node server.js &
SERVER_PID=$!

# Ожидание старта и открытие браузера
sleep 0.8
open "http://localhost:8080"

echo "Веб-интерфейс открыт в браузере."
echo "Чтобы остановить сервер, нажмите Ctrl+C или закройте это окно терминала."

# Перехват выхода
trap "kill $SERVER_PID 2>/dev/null; exit 0" INT TERM EXIT
wait $SERVER_PID
